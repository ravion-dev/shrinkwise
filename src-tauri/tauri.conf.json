{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ShrinkWise",
  "version": "3.0.0",
  "identifier": "com.shrinkwise.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "ShrinkWise",
        "width": 1280,
        "height": 820,
        "minWidth": 1000,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "backgroundColor": "#161513"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "ShrinkWise",
    "copyright": "Copyright © ShrinkWise",
    "category": "Utility",
    "shortDescription": "Shrink your files to the max with a single setting",
    "longDescription": "Compresses images, video, audio, GIF, PDF, office documents, archives, text and SVG with a single lossy setting. Fonts are copied unchanged.",
    "licenseFile": "../THIRD-PARTY.txt",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      },
      "nsis": {
        "installMode": "both",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "windows/hooks.nsh",
        "compression": "lzma"
      }
    }
  }
}